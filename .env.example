# Server Configuration
HOST=127.0.0.1
PORT=8000
DEBUG=False

# Storage & Paths
DATABASE_URL=sqlite:///./traffic_system.db
MODELS_DIR=./models
OUTPUTS_DIR=./outputs
EVIDENCE_DIR=./outputs/evidence
ANNOTATED_VIDEOS_DIR=./outputs/annotated_videos
UPLOADS_DIR=./outputs/uploads

# Vision & Inference Config
DEVICE=auto
YOLO_MODEL_NAME=yolov8n.pt
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
FRAME_SKIP=1
MAX_PROCESSING_FPS=30

# Detection Flags
ENABLE_SIGNAL_JUMP=True
ENABLE_TRIPLE_RIDING=True
ENABLE_HELMET_CHECK=True
ENABLE_PLATE_OCR=True
PRIVACY_BLUR=False

# Signal Jump Virtual Calibration (normalized coordinates 0.0 - 1.0 or pixel coordinates)
# Stop line: [x1, y1, x2, y2]
STOP_LINE=[0.1, 0.65, 0.9, 0.65]
# Signal region ROI: [x1, y1, x2, y2]
SIGNAL_ROI=[0.75, 0.05, 0.95, 0.35]
# Signal mode: auto_detect, red, green, yellow
SIGNAL_MODE=red
